pipeline{
agent any

stages {
    stage ('Git Checkout') {
        steps{
            checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/feature2']], extensions: [], userRemoteConfigs: [[credentialsId: 'git_cred_omalives', url: 'https://github.com/omalives/first_project.git']])
        }
    }
    stage ('Validate') {
        steps{
            withMaven(maven: 'maven_3.9') {
                echo 'mvn validate'
            }
        }
    }
    stage ('Compile') {
            steps{
                withMaven(maven: 'maven_3.9') {
                    echo 'mvn compile'
                }
            }
        }
    stage ('Run Test') {
                steps{
                    withMaven(maven: 'maven_3.9') {
                        echo 'mvn run test'
                    }
                }
            }
    stage ('SonarQube Analysis') {
    environment{
     sonarScan = tool 'oma-sonarqube'
    }
        withSonarQubeEnv(credentialsId: 'student-sonar-token', installationName: 'IBT Sonarqube') {
               echo "$sonarScan/bin/sonar-scanner"
                  }
              }
         }
    }
}