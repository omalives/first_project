pipeline{
agent any

stages {
    stage ('Git Checkout') {
        steps{
            checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/feature2']], extensions: [], userRemoteConfigs: [[credentialsId: 'git_cred_omalives', url: 'https://github.com/omalives/first_project.git']])
        }
    }
    stage ('Validate') {
        steps{
            withMaven(maven: 'maven_3.9') {
                echo 'mvn validate'
            }
        }
    }
    stage ('Compile') {
            steps{
                withMaven(maven: 'maven_3.9') {
                    echo 'mvn compile'
                }
            }
        }
    stage ('Run Test') {
                steps{
                    withMaven(maven: 'maven_3.9') {
                        echo 'mvn run test'
                    }
                }
            }
    stage('SonarQube Analysis') {
             environment{
                sonarScan = tool 'oma-sonarqube'
             }
             steps{
              withSonarQubeEnv(installationName: 'IBT Sonarqube', credentialsId: 'student-sonar-token') {
                echo "${env.sonarScan}/bin/sonar-scanner"
              }
           }
         }
    stage('Package'){
                 steps{
                     echo 'mvn package'
                 }
             }
     stage('Vulnerability Scan'){
             steps{
                 dependencyCheck additionalArguments: '''
                     -o "./"
                     -s "./"
                     -f "ALL"
                     --prettyPrint ''', odcInstallation: 'DP Check'
                 dependencyCheckPublisher pattern: 'dependency-check-report.xml'
             }
          }
     stage('upload to Artifactory'){
            steps{
            withCredentials([file(credentialsId: 'maven-settings', variable: 'mvn_settings')]) {
                withMaven(maven: 'maven_3.9') {
                                        echo 'mvn deploy -s $mvn_settings'
                                    }
            }
            }
      }
    }
}